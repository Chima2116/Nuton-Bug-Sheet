# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where Capture from Nuton opens (no trailing slash). Default is https://nuton.app
# NEXT_PUBLIC_NUTON_ORIGIN=https://nuton.app

# Server-only. Lets "New bug" turn a free-text note into a structured report with Claude.
# Without it the app still works and uses its built-in rules ("Basic" badge). Never prefix with NEXT_PUBLIC_.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
