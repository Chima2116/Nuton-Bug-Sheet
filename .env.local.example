# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where Capture from Nuton opens (no trailing slash). Default is https://nuton.app
# NEXT_PUBLIC_NUTON_ORIGIN=https://nuton.app

# Server-only. Lets "New bug" turn a free-text note into a structured report with an AI model.
# Set one of these. Without any, the app still works and uses its built-in rules ("Basic" badge).
# Never prefix them with NEXT_PUBLIC_.
# Google Gemini (has a free tier): key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.6-flash
# Anthropic Claude (paid):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# If both are set, Claude is used unless you set AI_PROVIDER=gemini.
# AI_PROVIDER=gemini
